# ---------------------------------------------------------------
# Makefile Contents: Common settings for Linux console applications

# --------------------------------------------------------------- 
# Setup my path to the DataReel library
GCODE_LIB_DIR = ../../3plibs/datareel
GCODE_INCLUDE_PATH = $(GCODE_LIB_DIR)/include

OBJ_EXT = .o
PATHSEP = /

ADD_INC_PATHS = -I$(GCODE_INCLUDE_PATH) -I../include -I../../include

# 11/18/2026: two RHEL 8 builds, install_fcrypt.sh picks one by the
# host's FIPS mode:
#   makefile_rhel8            RHEL 8 system OpenSSL 1.1.1k, Red Hat's
#                             FIPS-validated library, for FIPS mode hosts
#                             (no hybrid ML-KEM users)
#   makefile_rhel8_openssl35  OpenSSL 3.5 LTS built in statically
#                             (OPENSSL35_PREFIX, default /opt/openssl-3.5,
#                             made by build_openssl35.sh), for other hosts
# RHEL 9 and 10 use the system OpenSSL 3.5. The openssl3 packages for RHEL 8
# come from EPEL (not Red Hat, no FIPS provider) and are not used.
OPENSSL_INC_PATH =
OPENSSL_LIB_PATH =
OPENSSL_LIBS = -lssl -lcrypto
OS_LIBS =
OPENSSL_DEFMACS =
OPENSSL35_PREFIX ?= /opt/openssl-3.5
ifeq ($(RHEL),8)
     # glibc 2.28 keeps dlopen() in libdl (the PKCS#11 module loader)
     OS_LIBS = -ldl
     ifeq ($(OPENSSL35),1)
          OPENSSL_INC_PATH = -I$(OPENSSL35_PREFIX)/include
          OPENSSL_LIBS = $(OPENSSL35_PREFIX)/lib64/libssl.a $(OPENSSL35_PREFIX)/lib64/libcrypto.a
          OPENSSL_DEFMACS = -DFC_OPENSSL_STATIC
     else
          OPENSSL_DEFMACS = -DFC_RHEL8_SYSTEM_OPENSSL
     endif
endif
ADD_INC_PATHS += $(OPENSSL_INC_PATH)

# Define debug macros specific to the gxcode library
64BIT_DEFMACS = -D__64_BIT_DATABASE_ENGINE__ -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D_LARGE_FILES
ANSI_DEFMACS = -D__USE_ANSI_CPP__
CPP_DEFMACS = -D__USE_CPP_IOSTREAM__
DISPLAY_DEFMACS = -D__CONSOLE__
THREAD_DEFMACS = -D__REENTRANT__ 
POSIX_DEFMACS= -D_REENTRANT -D_POSIX_PTHREAD_SEMANTICS
UNICODE_DEMACS = -D__HAS_UNICODE__

# 10/25/2026: OpenSSL 3 builds (RHEL 9 and 10) load the OpenSC PKCS#11
# module directly, the RHEL 10 OpenSSL has no ENGINE API. OpenSSL 1.x
# builds (the RHEL 8 FIPS build on the system OpenSSL 1.1.1) use the
# pkcs11 engine; the RHEL 8 OpenSSL 3.5 build uses the PKCS#11 module.
# 10/25/2026: RHEL 10 is the default when RHEL is not set. Use
# makefile_rhel8 or makefile_rhel9 for older RHEL builds. RHEL 6 and 7
# are no longer supported.
ifeq ($(RHEL),8)
     SMARTCARD_DEMACS = -D__ENABLE_SMART_CARD__ -D__RHEL8__
else ifeq ($(RHEL),9)
     SMARTCARD_DEMACS = -D__ENABLE_SMART_CARD__ -D__RHEL9__
else ifeq ($(RHEL),10)
     SMARTCARD_DEMACS = -D__ENABLE_SMART_CARD__ -D__RHEL10__
else
     SMARTCARD_DEMACS = -D__ENABLE_SMART_CARD__ -D__RHEL10__
endif

# Setup define macros
DEFMACS = -D__UNIX__ -D__POSIX__ -D__LINUX__ -D__X86__ \
$(64BIT_DEFMACS) $(ANSI_DEFMACS) $(BTREE_DEFMACS) $(CPP_DEFMACS) \
$(DATABASE_DEFMACS) $(DEBUG_DEFMACS) $(DEVCACHE_DEFMACS) $(DISPLAY_DEFMACS) \
$(FILESYS_DEFMACS) $(TESTCODE_DEFMACS) $(PS_DEFMACS) $(HTM_DEFMACS) \
$(TXT_DEFMACS) $(IO_DEFMACS) $(THREAD_DEFMACS) $(POSIX_DEFMACS) \
$(UNICODE_DEMACS) $(SMARTCARD_DEMACS) $(OPENSSL_DEFMACS)

# Define macros for compiler and linker
CC = gcc
CPP = g++ 
LINKER = ld

# Define compiler and linker flags macros
# NOTE: For extended debugging add: -g -O0 -v -da -Q 
DEBUG_FLAGS = -Wall -g $(ADD_INC_PATHS) $(DEFMACS)  -fpermissive
RELEASE_FLAGS = -Wall -O2 $(ADD_INC_PATHS) $(DEFMACS) -fpermissive

ifeq ($(FINAL),1)
	COMPILE_FLAGS = $(RELEASE_FLAGS)
else
	COMPILE_FLAGS = $(DEBUG_FLAGS)
endif

COMPILE_ONLY = -c
OUTPUT = -o
LINKER_FLAGS = -lpthread -lm $(OPENSSL_LIB_PATH) $(OPENSSL_LIBS) $(OS_LIBS)

